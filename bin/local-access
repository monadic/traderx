#!/bin/bash
set -euo pipefail

# TraderX Local Access Setup
# Sets up port-forwarding and opens browser for local development
#
# Usage:
#   bin/local-access              # Start port-forward and open browser
#   bin/local-access --check      # Check if setup is correct
#   bin/local-access --stop       # Stop port-forward
#   bin/local-access --status     # Show current status

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

HOST="traderx.local"
PORT=8080

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

check_hosts_file() {
  if grep -q "^127.0.0.1.*$HOST" /etc/hosts 2>/dev/null; then
    echo -e "${GREEN}✓${NC} /etc/hosts contains $HOST"
    return 0
  else
    echo -e "${RED}✗${NC} /etc/hosts missing $HOST entry"
    echo ""
    echo "Add this line to /etc/hosts:"
    echo -e "${YELLOW}  sudo sh -c 'echo \"127.0.0.1 $HOST\" >> /etc/hosts'${NC}"
    return 1
  fi
}

check_ingress_nginx() {
  if kubectl get svc ingress-nginx-controller -n ingress-nginx &>/dev/null; then
    echo -e "${GREEN}✓${NC} ingress-nginx-controller service found"
    return 0
  else
    echo -e "${RED}✗${NC} ingress-nginx-controller not found"
    echo ""
    echo "Install nginx-ingress controller:"
    echo -e "${YELLOW}  kubectl apply -f https://raw.githubusercontent.com/kubernetes/ingress-nginx/controller-v1.8.2/deploy/static/provider/kind/deploy.yaml${NC}"
    return 1
  fi
}

check_traderx_ingress() {
  if kubectl get ingress traderx-ingress -n traderx-dev &>/dev/null; then
    echo -e "${GREEN}✓${NC} traderx-ingress deployed in traderx-dev"
    return 0
  else
    echo -e "${RED}✗${NC} traderx-ingress not found"
    echo ""
    echo "Deploy TraderX first:"
    echo -e "${YELLOW}  bin/ordered-apply dev${NC}"
    return 1
  fi
}

check_port_forward() {
  if pgrep -f "port-forward.*ingress-nginx-controller.*$PORT:80" &>/dev/null; then
    echo -e "${GREEN}✓${NC} Port-forward running on :$PORT"
    return 0
  else
    echo -e "${YELLOW}○${NC} Port-forward not running"
    return 1
  fi
}

start_port_forward() {
  echo "Starting port-forward to ingress-nginx-controller..."

  # Kill existing port-forwards on this port
  pkill -f "port-forward.*$PORT:80" 2>/dev/null || true
  sleep 1

  # Start new port-forward in background
  kubectl port-forward svc/ingress-nginx-controller -n ingress-nginx $PORT:80 &>/dev/null &

  # Wait for it to start
  sleep 2

  # Verify it's working
  if curl -s -o /dev/null -w "%{http_code}" -H "Host: $HOST" "http://localhost:$PORT/" 2>/dev/null | grep -q "200"; then
    echo -e "${GREEN}✓${NC} Port-forward started and verified"
    return 0
  else
    echo -e "${RED}✗${NC} Port-forward started but not responding"
    return 1
  fi
}

stop_port_forward() {
  echo "Stopping port-forward..."
  pkill -f "port-forward.*ingress-nginx-controller" 2>/dev/null || true
  echo -e "${GREEN}✓${NC} Port-forward stopped"
}

show_status() {
  echo "TraderX Local Access Status"
  echo "============================"
  echo ""
  check_hosts_file || true
  check_ingress_nginx || true
  check_traderx_ingress || true
  check_port_forward || true
  echo ""
  echo "Access URL: http://$HOST:$PORT"
}

run_check() {
  echo "Checking TraderX local access requirements..."
  echo ""

  local errors=0
  check_hosts_file || ((errors++))
  check_ingress_nginx || ((errors++))
  check_traderx_ingress || ((errors++))

  echo ""
  if [ $errors -eq 0 ]; then
    echo -e "${GREEN}All checks passed!${NC}"
    return 0
  else
    echo -e "${RED}$errors check(s) failed${NC}"
    return 1
  fi
}

open_browser() {
  local url="http://$HOST:$PORT"
  echo "Opening browser: $url"

  case "$(uname)" in
    Darwin) open "$url" ;;
    Linux) xdg-open "$url" 2>/dev/null || echo "Open $url in your browser" ;;
    *) echo "Open $url in your browser" ;;
  esac
}

# Main
case "${1:-}" in
  --check)
    run_check
    ;;
  --stop)
    stop_port_forward
    ;;
  --status)
    show_status
    ;;
  --help|-h)
    echo "Usage: bin/local-access [--check|--stop|--status|--help]"
    echo ""
    echo "Options:"
    echo "  (no args)   Start port-forward and open browser"
    echo "  --check     Check if all requirements are met"
    echo "  --stop      Stop the port-forward"
    echo "  --status    Show current status"
    echo "  --help      Show this help"
    ;;
  *)
    echo "TraderX Local Access"
    echo "===================="
    echo ""

    # Run checks first
    if ! run_check; then
      echo ""
      echo "Fix the issues above and try again."
      exit 1
    fi

    echo ""

    # Start port-forward if not running
    if ! check_port_forward; then
      start_port_forward
    fi

    echo ""
    echo "TraderX is ready!"
    echo ""
    echo "  URL: http://$HOST:$PORT"
    echo ""
    echo "To stop: bin/local-access --stop"
    echo ""

    # Open browser
    open_browser
    ;;
esac
