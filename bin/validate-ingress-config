#!/bin/bash
# Validate ingress configuration for correct path rewriting
# This catches the common mistake of using rewrite-target without regex capture groups

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TRADERX_DIR="$(dirname "$SCRIPT_DIR")"
INGRESS_FILE="$TRADERX_DIR/confighub/base/ingress.yaml"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ERRORS=0

echo "Validating ingress configuration..."
echo ""

# Check if ingress file exists
if [ ! -f "$INGRESS_FILE" ]; then
  echo -e "${RED}✗ Ingress file not found: $INGRESS_FILE${NC}"
  exit 1
fi

# Validate YAML syntax using kubectl
if ! kubectl apply --dry-run=client -f "$INGRESS_FILE" >/dev/null 2>&1; then
  echo -e "${RED}✗ Invalid YAML syntax in $INGRESS_FILE${NC}"
  kubectl apply --dry-run=client -f "$INGRESS_FILE" 2>&1 | head -5
  exit 1
fi
echo -e "${GREEN}✓${NC} YAML syntax valid"

# Check for rewrite-target annotation
if grep -q "rewrite-target:" "$INGRESS_FILE"; then
  echo -e "${GREEN}✓${NC} Found rewrite-target annotation"

  # If using rewrite-target with capture groups ($1, $2), must have use-regex: "true"
  REWRITE_TARGET=$(grep "rewrite-target:" "$INGRESS_FILE" | head -1)
  if echo "$REWRITE_TARGET" | grep -q '\$[0-9]'; then
    echo "  Rewrite target uses capture groups: $REWRITE_TARGET"

    if ! grep -q 'use-regex.*"true"' "$INGRESS_FILE"; then
      echo -e "${RED}✗ ERROR: rewrite-target uses \$N but use-regex is not enabled${NC}"
      echo "  Add: nginx.ingress.kubernetes.io/use-regex: \"true\""
      ((ERRORS++))
    else
      echo -e "${GREEN}✓${NC} use-regex: \"true\" is enabled"
    fi
  fi

  # Check for common mistake: rewrite-target: / without regex
  if echo "$REWRITE_TARGET" | grep -q 'rewrite-target: /$' || echo "$REWRITE_TARGET" | grep -q "rewrite-target: '/'"; then
    # Check if any API paths exist
    if grep -q '/api/' "$INGRESS_FILE"; then
      echo -e "${YELLOW}⚠ WARNING: rewrite-target: / with API paths may strip sub-paths${NC}"
      echo "  Consider using: rewrite-target: /\$2 with regex paths like /api/foo(/|\$)(.*)"
    fi
  fi
fi

# Check path patterns for API routes
echo ""
echo "Checking API path patterns..."

# Look for API paths without regex capture groups
API_PATHS=$(grep -E '^\s+- path: /api/' "$INGRESS_FILE" || true)
if [ -n "$API_PATHS" ]; then
  while IFS= read -r line; do
    if ! echo "$line" | grep -q '(/|$)(.*)'; then
      PATH_VALUE=$(echo "$line" | sed 's/.*path: //')
      echo -e "${YELLOW}⚠ API path without capture group: $PATH_VALUE${NC}"
      echo "  Consider: ${PATH_VALUE}(/|\$)(.*) for proper sub-path handling"
    fi
  done <<< "$API_PATHS"
else
  echo -e "${GREEN}✓${NC} All API paths use regex capture groups"
fi

# Check pathType for regex paths
if grep -q 'use-regex.*"true"' "$INGRESS_FILE"; then
  WRONG_PATHTYPE=$(grep -B1 'path:.*(/|$)' "$INGRESS_FILE" | grep -v "ImplementationSpecific" | grep "pathType:" || true)
  if [ -n "$WRONG_PATHTYPE" ]; then
    echo -e "${RED}✗ Regex paths should use pathType: ImplementationSpecific${NC}"
    ((ERRORS++))
  else
    echo -e "${GREEN}✓${NC} Regex paths use correct pathType"
  fi
fi

echo ""
if [ $ERRORS -eq 0 ]; then
  echo -e "${GREEN}✓ Ingress configuration valid${NC}"
  exit 0
else
  echo -e "${RED}✗ Found $ERRORS configuration errors${NC}"
  exit 1
fi
