#!/bin/bash
# TraderX Validated Deployment
# Runs scripts with pre/post condition verification using verified predicates
# Generated from ~/verified/traderx-proposals.json

set -uo pipefail
# Note: not using -e so we can capture failures and continue

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TRADERX_DIR="$(dirname "$SCRIPT_DIR")"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

PASS=0
FAIL=0
SKIP=0

log_pass() { echo -e "${GREEN}✓${NC} $1"; ((PASS++)); }
log_fail() { echo -e "${RED}✗${NC} $1"; ((FAIL++)); }
log_skip() { echo -e "${YELLOW}○${NC} $1 (skipped)"; ((SKIP++)); }
log_info() { echo -e "  $1"; }

assert() {
  local desc="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    log_pass "$desc"
    return 0
  else
    log_fail "$desc"
    return 1
  fi
}

assert_not() {
  local desc="$1"
  shift
  if ! "$@" >/dev/null 2>&1; then
    log_pass "$desc"
    return 0
  else
    log_fail "$desc"
    return 1
  fi
}

# ============================================================
# PHASE 0: Prerequisites
# ============================================================
echo ""
echo "═══════════════════════════════════════════════════════════════"
echo "PHASE 0: Prerequisites Check"
echo "═══════════════════════════════════════════════════════════════"

echo ""
echo "Checking ConfigHub authentication..."
# Check both that token exists AND that it works for API calls
if ! cub auth get-token >/dev/null 2>&1; then
  echo -e "${RED}ERROR: Not authenticated with ConfigHub${NC}"
  echo "Please run: cub auth login"
  exit 1
fi

# Actually test the token with a real API call
if ! cub space list >/dev/null 2>&1; then
  echo -e "${RED}ERROR: ConfigHub token is invalid or expired${NC}"
  echo "Please run: cub auth login"
  exit 1
fi
log_pass "ConfigHub authentication valid (token verified)"

echo ""
echo "Checking ConfigHub CLI..."
assert "cub CLI is installed" command -v cub

K8S_AVAILABLE=true
echo ""
echo "Checking Kubernetes cluster..."
if kubectl cluster-info >/dev/null 2>&1; then
  log_pass "Kubernetes cluster accessible"
else
  log_skip "Kubernetes cluster not accessible (will skip deployment steps)"
  K8S_AVAILABLE=false
fi

# ============================================================
# PHASE 1: Install Base Structure
# ============================================================
echo ""
echo "═══════════════════════════════════════════════════════════════"
echo "PHASE 1: Install Base Structure (bin/install-base)"
echo "═══════════════════════════════════════════════════════════════"

echo ""
echo "PRE: Checking preconditions..."
# These should pass before running install-base (first time setup)

echo ""
echo "RUNNING: bin/install-base"
cd "$TRADERX_DIR"
if bin/install-base; then
  log_pass "install-base completed successfully"
else
  log_fail "install-base failed"
  echo "Check output above for details"
  exit 1
fi

echo ""
echo "POST: Verifying postconditions..."
PROJECT=$(cat .cub-project)
echo "Project: $PROJECT"

assert "Base space exists" cub space get "${PROJECT}-base"
assert "Filters space exists" cub space get "${PROJECT}-filters"
assert "Filter 'all' exists" cub filter get all --space "${PROJECT}-filters" 2>/dev/null || cub filter list --space "${PROJECT}-filters" | grep -q "all"

# Count units in base space (use table output and count lines)
UNIT_COUNT=$(cub unit list --space "${PROJECT}-base" 2>/dev/null | tail -n +2 | wc -l | tr -d ' ')
echo "Units created in base space: $UNIT_COUNT"
if [ "$UNIT_COUNT" -gt 10 ]; then
  log_pass "Multiple units created (found $UNIT_COUNT)"
else
  log_fail "Expected more units (found $UNIT_COUNT)"
fi

# ============================================================
# PHASE 2: Install Environments
# ============================================================
echo ""
echo "═══════════════════════════════════════════════════════════════"
echo "PHASE 2: Install Environments (bin/install-envs)"
echo "═══════════════════════════════════════════════════════════════"

echo ""
echo "PRE: Checking preconditions..."
assert "Project file exists" test -f "$TRADERX_DIR/.cub-project"
assert "Base space exists" cub space get "${PROJECT}-base"

echo ""
echo "RUNNING: bin/install-envs"
if bin/install-envs; then
  log_pass "install-envs completed successfully"
else
  log_fail "install-envs failed"
fi

echo ""
echo "POST: Verifying postconditions..."
assert "Dev space exists" cub space get "${PROJECT}-dev"
assert "Staging space exists" cub space get "${PROJECT}-staging"
assert "Prod space exists" cub space get "${PROJECT}-prod"

# Check units were cloned to dev (use table output and count lines)
DEV_UNIT_COUNT=$(cub unit list --space "${PROJECT}-dev" 2>/dev/null | tail -n +2 | wc -l | tr -d ' ')
echo "Units in dev space: $DEV_UNIT_COUNT"
if [ "$DEV_UNIT_COUNT" -gt 10 ]; then
  log_pass "Dev environment has units (found $DEV_UNIT_COUNT)"
fi

# ============================================================
# PHASE 3: Setup Worker (requires K8s)
# ============================================================
echo ""
echo "═══════════════════════════════════════════════════════════════"
echo "PHASE 3: Setup Worker (bin/setup-worker dev)"
echo "═══════════════════════════════════════════════════════════════"

if [ "$K8S_AVAILABLE" = "true" ]; then
  echo ""
  echo "PRE: Checking preconditions..."
  assert "Dev space exists" cub space get "${PROJECT}-dev"

  echo ""
  echo "RUNNING: bin/setup-worker dev"
  if bin/setup-worker dev; then
    log_pass "setup-worker completed successfully"
  else
    log_fail "setup-worker failed"
  fi

  echo ""
  echo "POST: Verifying postconditions..."
  # Check worker exists
  if cub worker list --space "${PROJECT}-dev" 2>/dev/null | grep -q .; then
    log_pass "Worker registered in dev space"
  else
    log_skip "Worker not yet registered (may take a moment)"
  fi
else
  log_skip "Kubernetes not available - skipping worker setup"
fi

# ============================================================
# PHASE 4: Deploy to Dev (requires K8s)
# ============================================================
echo ""
echo "═══════════════════════════════════════════════════════════════"
echo "PHASE 4: Deploy to Dev (bin/ordered-apply dev)"
echo "═══════════════════════════════════════════════════════════════"

if [ "$K8S_AVAILABLE" = "true" ]; then
  echo ""
  echo "PRE: Checking preconditions..."
  assert "Dev space exists" cub space get "${PROJECT}-dev"

  echo ""
  echo "RUNNING: bin/ordered-apply dev"
  if timeout 300 bin/ordered-apply dev; then
    log_pass "ordered-apply completed successfully"
  else
    log_fail "ordered-apply failed or timed out"
  fi

  echo ""
  echo "POST: Verifying deployment..."
  # Check pods are running
  RUNNING_PODS=$(kubectl get pods -n traderx-dev --no-headers 2>/dev/null | grep -c "Running" || echo "0")
  echo "Running pods in traderx-dev: $RUNNING_PODS"
  if [ "$RUNNING_PODS" -gt 5 ]; then
    log_pass "Multiple pods running (found $RUNNING_PODS)"
  else
    log_skip "Waiting for pods to start"
  fi
else
  log_skip "Kubernetes not available - skipping deployment"
fi

# ============================================================
# PHASE 5: Validate API Routing (requires K8s)
# ============================================================
echo ""
echo "═══════════════════════════════════════════════════════════════"
echo "PHASE 5: Validate API Routing through Ingress"
echo "═══════════════════════════════════════════════════════════════"

if [ "$K8S_AVAILABLE" = "true" ]; then
  echo ""
  echo "Setting up port-forward to ingress..."

  # Kill any existing port-forward on 18080
  pkill -f "port-forward.*18080" 2>/dev/null || true
  sleep 1

  # Start port-forward to ingress
  kubectl port-forward svc/ingress-nginx-controller -n ingress-nginx 18080:80 &
  PF_PID=$!
  sleep 3

  echo ""
  echo "Testing API endpoints through ingress..."

  # Test frontend
  FRONTEND_STATUS=$(curl -s -o /dev/null -w "%{http_code}" -H "Host: traderx.local" http://localhost:18080/ 2>/dev/null)
  if [ "$FRONTEND_STATUS" = "200" ]; then
    log_pass "Frontend accessible (HTTP $FRONTEND_STATUS)"
  else
    log_fail "Frontend not accessible (HTTP $FRONTEND_STATUS)"
  fi

  # Test reference-data API - must return JSON array, not HTML
  REF_DATA=$(curl -s -H "Host: traderx.local" http://localhost:18080/api/reference-data/stocks 2>/dev/null | head -c 20)
  if echo "$REF_DATA" | grep -q '^\[{"ticker"'; then
    log_pass "Reference-data API returns JSON data"
  else
    log_fail "Reference-data API routing broken (got: $REF_DATA)"
  fi

  # Test accounts API - must return JSON array, not HTML
  ACCOUNTS_DATA=$(curl -s -H "Host: traderx.local" http://localhost:18080/api/accounts/account/ 2>/dev/null | head -c 20)
  if echo "$ACCOUNTS_DATA" | grep -q '^\[{"id"'; then
    log_pass "Accounts API returns JSON data"
  else
    log_fail "Accounts API routing broken (got: $ACCOUNTS_DATA)"
  fi

  # Test people API
  PEOPLE_STATUS=$(curl -s -o /dev/null -w "%{http_code}" -H "Host: traderx.local" http://localhost:18080/api/people/person/ 2>/dev/null)
  if [ "$PEOPLE_STATUS" = "200" ]; then
    log_pass "People API accessible (HTTP $PEOPLE_STATUS)"
  else
    log_skip "People API returned HTTP $PEOPLE_STATUS"
  fi

  # Cleanup port-forward
  kill $PF_PID 2>/dev/null || true

else
  log_skip "Kubernetes not available - skipping API validation"
fi

# ============================================================
# Summary
# ============================================================
echo ""
echo "═══════════════════════════════════════════════════════════════"
echo "VALIDATION SUMMARY"
echo "═══════════════════════════════════════════════════════════════"
echo ""
echo -e "  ${GREEN}Passed:${NC}  $PASS"
echo -e "  ${RED}Failed:${NC}  $FAIL"
echo -e "  ${YELLOW}Skipped:${NC} $SKIP"
echo ""

if [ "$FAIL" -eq 0 ]; then
  echo -e "${GREEN}✓ All validations passed!${NC}"
  exit 0
else
  echo -e "${RED}✗ Some validations failed${NC}"
  exit 1
fi
